# 硅基流动 API 密钥（https://siliconflow.cn）
SILICONFLOW_API_KEY=your-key-here
# DeepSeek API 密钥（https://platform.deepseek.com）
DEEPSEEK_API_KEY=your-key-here
# Embedding 模型
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# LLM 模型
LLM_MODEL=deepseek-chat
# 分块大小
CHUNK_SIZE=400
CHUNK_OVERLAP=60
# ChromaDB 设置
COLLECTION_NAME=company_wiki
DB_DIR=./chroma_db

# MySQL 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=your-db-password
DB_NAME=company_rag

# SMTP 邮件服务 (163 邮箱示例)
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=your-email@163.com
SMTP_PASS=your-smtp-auth-code
SMTP_FROM=your-email@163.com
